# Contraseña de la web de administración.
ADMIN_PASSWORD=

# Supabase > Project Settings > API (o Data API): URL y la clave service_role (secreta).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Pegá el JSON entero (o en base64).
FIREBASE_SERVICE_ACCOUNT=
# Firebase > Configuración del proyecto > General > tu app Android (com.plaude.glyph):
# "ID de la app" (1:...:android:...) y la "Clave de API web" (Web API key).
FIREBASE_APP_ID=
FIREBASE_API_KEY=
